# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env (con valores reales) al repositorio.

# Cadena de conexión de PostgreSQL. En local, tu Postgres local.
# En despliegue, la "Connection string" de Neon (usa el modo "pooled"
# si Render no soporta conexiones directas concurrentes).
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/coflow

# Autenticación (JWT). Genera SECRET_KEY con algo como:
#   python -c "import secrets; print(secrets.token_hex(32))"
# No reutilices el mismo valor entre entornos.
SECRET_KEY=change-me-generate-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# "development" en local, "production" en el despliegue de Render.
ENVIRONMENT=development

# URL pública del frontend desplegado (Vercel). Se añade automáticamente
# a los orígenes permitidos por CORS. En local no hace falta definirla:
# localhost:3000 siempre está permitido.
FRONTEND_URL=

# Orígenes adicionales para CORS, separados por comas (opcional). Útil
# para añadir una URL de preview de Vercel además del dominio principal.
CORS_ALLOWED_ORIGINS=

# URL pública real desde la que el backend sirve /media. En local, la
# URL donde corre uvicorn. En despliegue, la URL pública de Render.
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# Mientras sea false, no existen endpoints públicos de propiedades y
# ningún piso es visible fuera del panel de su propietario.
PROPERTY_MARKETPLACE_ENABLED=false

# El almacenamiento local de imágenes usa disco efímero: se pierde en
# cada redeploy/reinicio y no se comparte entre instancias. Se bloquea
# automáticamente si ENVIRONMENT=production, salvo que actives esto
# explícitamente para un despliegue de pruebas temporal.
ALLOW_LOCAL_MEDIA_IN_PRODUCTION=false

# --- TrueLayer (Open Banking sandbox) ---------------------------------
# Credenciales de tu app en https://console.truelayer.com. Sin estas
# tres, cualquier endpoint de /bank-connections falla explícitamente.
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la redirect URI configurada en la
# consola de TrueLayer (ej. https://tu-frontend/pasaporte/callback).
TRUELAYER_REDIRECT_URI=
# "sandbox" en desarrollo/pruebas, "live" cuando se active producción
# real (no activado todavía en este proyecto).
TRUELAYER_ENVIRONMENT=sandbox

# Clave Fernet usada para cifrar en reposo los tokens bancarios
# (access_token/refresh_token de TrueLayer). Distinta de SECRET_KEY, no
# la reutilices. Genera un valor con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_TOKEN_ENCRYPTION_KEY=

# Habilita /financial-analysis/debug/* (auditoría de clasificación e
# ingresos recurrentes, solo agregados anonimizados). Activo por defecto
# fuera de producción; en producción queda desactivado salvo que pongas
# esto en "true" explícitamente. Preferencia: no activarlo en real.
ENABLE_FINANCIAL_DEBUG=false

# Secreto para derivar (HMAC-SHA256) el token público de los enlaces
# verificables del Pasaporte de Solvencia. Nunca se guarda en la base de
# datos en ninguna forma: se recalcula bajo demanda. Distinta de
# BANK_TOKEN_ENCRYPTION_KEY y de SECRET_KEY. Genera un valor con:
#   python -c "import secrets; print(secrets.token_hex(32))"
PASSPORT_SHARE_SECRET=

# --- Verificación de email (Resend) -----------------------------------
# API key de https://resend.com/api-keys. Sin esta variable (y con
# EMAIL_DELIVERY_MODE=resend) los emails no se envían: se loguea un
# aviso claro pero el registro nunca falla por esto.
RESEND_API_KEY=
# Remitente transaccional. En producción debe ser un dominio verificado
# en Resend (ver pasos de despliegue en DEPLOYMENT.md).
EMAIL_FROM=CoFlow <onboarding@resend.dev>
# "resend" envía de verdad. "console" (recomendado en local) solo deja
# constancia en el log de que se generó un enlace, sin token ni URL.
EMAIL_DELIVERY_MODE=console
EMAIL_VERIFICATION_EXPIRY_MINUTES=30
# Si es "true" (y ENVIRONMENT != production), /auth/register y
# /auth/resend-verification devuelven "debug_token" en la respuesta,
# para que los tests puedan verificar el email sin leer Resend. NUNCA
# lo actives en producción.
EMAIL_VERIFICATION_TEST_MODE=true
